<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!--
	  Required once a Developer ID + Hardened Runtime build replaces
	  the current ad-hoc-signed shape: SSH local-port-forward (-L) +
	  remote-listener (-R) call bind() / connect() under the
	  Hardened Runtime sandbox, and missing entitlements turn into
	  silent EPERM. Wired here now so enabling Hardened Runtime is a
	  one-line build-config flip, not a "why does -L not work" debug
	  loop after the fact.
	-->
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<!--
	  Apple Secure Enclave SSH keys (lfs_os_security::apple_se_ssh)
	  bind their private half under a per-key kSecAttrApplicationTag
	  in the user keychain. With `app-sandbox = false` above, no
	  `keychain-access-groups` entitlement is needed — the unsandboxed
	  process accesses the user-default keychain directly. When a
	  future Developer ID + Hardened Runtime build flips sandbox on,
	  add:
	    <key>keychain-access-groups</key>
	    <array>
	      <string>$(TeamIdentifierPrefix)com.poddeo3.letsflutssh</string>
	    </array>
	  so the bound keys remain accessible across the team identity.
	  ad-hoc-signed dev builds will surface
	  `errSecMissingEntitlement (-34018)` on `SecKeyCreateRandomKey`;
	  the wizard probe step routes the user at the documented
	  `codesign -s -` remediation in USER_GUIDE.md.
	-->
</dict>
</plist>
