<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Bundle identity -->
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>LFssh</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>LetsFLUTssh</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>

	<!-- Supported localizations -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>ru</string>
		<string>zh</string>
		<string>de</string>
		<string>ja</string>
		<string>pt</string>
		<string>es</string>
		<string>fr</string>
		<string>ko</string>
		<string>ar</string>
		<string>fa</string>
		<string>tr</string>
		<string>vi</string>
		<string>id</string>
		<string>hi</string>
	</array>

	<!-- System requirements -->
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- Performance -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>

	<!-- Scene & UI configuration -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>

	<!-- URL schemes & deep links -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.letsflutssh.deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>letsflutssh</string>
			</array>
		</dict>
	</array>
	<!-- FlutterDeepLinkingEnabled retired — `app_links` package
	     handles the inbound URL stream and routes through the
	     `DeeplinkDispatcher` Rust singleton. Leaving the flag on
	     would intercept the launch URL through Flutter's own
	     handler before app_links sees it (the audit's B-PI-4
	     finding) and the deep link would land twice in the
	     dispatch queue. -->

	<!-- Privacy descriptions -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>LetsFLUTssh needs local network access to connect to SSH servers on your network.</string>
	<key>NSCameraUsageDescription</key>
	<string>LetsFLUTssh uses the camera only to scan QR codes when you tap "Scan QR" to import sessions.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>LetsFLUTssh uses Face ID to unlock your encrypted session store without typing the master password every time.</string>

	<!-- Interface orientations -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- iOS doesn't allow indefinite background TCP — Apple's
	     suspended-app contract closes every socket the moment the
	     app loses foreground. The audit's B-PLAT-5 / B-PI-1 ask is
	     for a graceful "session resumed → reconnect last connection"
	     path on foreground-return rather than chasing a background
	     mode the platform won't honour. The lifecycle observer in
	     `lib/main_app.dart` tracks `AppLifecycleState.resumed`; the
	     reconnect surfaces in the connection bar as a "Reconnect?"
	     prompt the user can dismiss or accept.
	     If a future iOS release adds a long-running networking
	     mode that fits SSH (no Apple precedent today), declare it
	     here as `UIBackgroundModes` and pair with a foreground-task
	     plugin shape; until then this comment is the project-wide
	     "we considered it" record. -->
</dict>
</plist>
