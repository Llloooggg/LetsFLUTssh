<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network: SSH/SFTP connections -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Foreground service: keeps SSH connections alive when screen is locked -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Storage: local file browser for SFTP transfers. The local
         file pane browses the whole device filesystem, and .lfs export
         writes to any user-chosen folder without a per-folder SAF
         consent prompt each time — both need broad access, so the app
         requests MANAGE_EXTERNAL_STORAGE (Android 11+, granted via the
         system "All files access" screen) with the scoped
         READ_/WRITE_EXTERNAL_STORAGE kept for the legacy SDK path.
         The app ships via GitHub / F-Droid APKs, not Play Store, so the
         Play "Special Permission" review path does not apply. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- Camera: QR scanner (used only for the "Scan QR" action in Settings) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Biometric unlock (optional, only when user enables it in Security settings) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <!-- API 33+ (Android 13+) requires runtime POST_NOTIFICATIONS for
         every app that posts a notification, including the foreground
         service that keeps SSH alive. Without it, Android 13+ silently
         suppresses the persistent notification — the foreground service
         still runs but the user has no UI cue that an SSH connection is
         alive in the background. The runtime grant is requested via
         flutter_foreground_task's `requestPermission` API on first start. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Optional opt-in: REQUEST_IGNORE_BATTERY_OPTIMIZATIONS lets
         the user grant the app a Doze allowlist slot from Settings →
         Battery. Without it, Android Doze can suspend the foreground
         service after extended idle (~30 min screen-off) and SSH
         connections drop silently. The grant is opt-in only; the app
         never auto-prompts (Play Store policy) — the Settings →
         Connection panel surfaces a "Disable battery optimization"
         button that fires the system dialog. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- In-app update: install the downloaded, signature-verified apk.
         API 26+ also gates this behind a per-app "install unknown apps"
         grant the user toggles once (the installer flow opens that
         settings screen when the grant is missing). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="LFssh"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:requestLegacyExternalStorage="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"
            />

            <!-- Main launcher -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link: letsflutssh://connect?host=X&port=22&user=Y -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="letsflutssh" />
            </intent-filter>

            <!-- No file-extension intent filters. The app does not register to
                 open .pem / .key / .pub / .lfs (or any extension) — those belong
                 to the user's own tools, and .lfs archives import via drag-drop /
                 the in-app picker, not an OS file hand-off. Only the
                 letsflutssh:// scheme above is handled. -->
        </activity>

        <!-- QR scanner activity: shown only when the user taps "Scan QR".
             Launched as a singleTask child of MainActivity through a
             MethodChannel; result is delivered back via Activity.onActivityResult. -->
        <activity
            android:name=".QrScannerActivity"
            android:exported="false"
            android:theme="@style/QrScannerTheme"
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|layoutDirection|fontScale|density" />

        <!-- Flutter engine registration -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Foreground service: keeps SSH alive when screen is locked -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- Serves the downloaded update apk to the system package
             installer via a content:// URI (ACTION_VIEW can't read a
             raw file:// path from app-internal storage on API 24+). The
             apk lives under the app's files dir (getApplicationSupportDirectory);
             file_paths.xml roots the provider there. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Package visibility for text processing -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

</manifest>